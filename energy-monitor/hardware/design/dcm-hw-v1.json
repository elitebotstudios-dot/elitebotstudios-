{
  "design": {
    "id": "DCM-HW-V1",
    "title": "Smart DC Energy Monitor — measurement carrier, hardware design V1",
    "revision": "B",
    "date": "2026-11-06",
    "status": "design-complete-draft",
    "status_note": "Native KiCad schematic, ERC checked with kicad-cli 9.0.2; firmware cross-compiled for the ESP32. Nothing has been built, powered, measured or calibrated.",
    "author": "Elite Bot Studios (AI-assisted)",
    "envelope": {
      "vin_nominal_v": 12,
      "vin_min_v": 5,
      "vin_max_v": 12,
      "i_max_a": 0.5,
      "i_absolute_measure_a": 0.8192,
      "load": "resistive, low voltage DC",
      "supply": "current-limited bench supply, <= 1 A limit"
    }
  },
  "components": [
    {
      "ref": "J1",
      "value": "2-way 5.08 mm",
      "part": "Phoenix MKDS 1/2-5.08 or equivalent",
      "manufacturer": "Phoenix Contact (or equivalent)",
      "function": "DC input terminals",
      "ratings": {
        "current_a": 10,
        "voltage_v": 300
      },
      "pins": [
        {
          "number": "1",
          "name": "+",
          "net": "VIN"
        },
        {
          "number": "2",
          "name": "-",
          "net": "GND"
        }
      ],
      "rationale": "Screw terminals accept the bench-supply leads and are rated far above the 1 A design current. Alternatives: Wago 233 series, or a 5.5/2.1 mm barrel jack (less safe to probe).",
      "datasheet": "manufacturer-terminal-blocks",
      "symbol": "terminal"
    },
    {
      "ref": "F1",
      "value": "1.1 A hold / 2.2 A trip",
      "part": "Bourns MF-R110",
      "manufacturer": "Bourns",
      "function": "Resettable series protection",
      "ratings": {
        "hold_a": 1.1,
        "trip_a": 2.2,
        "voltage_v": 60
      },
      "pins": [
        {
          "number": "1",
          "name": "in",
          "net": "VIN"
        },
        {
          "number": "2",
          "name": "out",
          "net": "VFUSED"
        }
      ],
      "rationale": "A PTC at 0.5 A continuous runs well below its 1.1 A hold current, so it does not nuisance-trip, while still limiting a fault. The bench supply's own current limit remains the primary protection; this is the second line. Alternatives: 0.75 A PTC (closer to the load but less margin), or a 1 A blade fuse (not resettable).",
      "datasheet": "bourns-mf-r",
      "symbol": "fuse"
    },
    {
      "ref": "D1",
      "value": "3 A 40 V Schottky",
      "part": "onsemi SS34",
      "manufacturer": "onsemi",
      "function": "Reverse-polarity protection",
      "ratings": {
        "if_a": 3,
        "vr_v": 40,
        "vf_v": 0.5
      },
      "pins": [
        {
          "number": "A",
          "name": "anode",
          "net": "VFUSED",
          "kicad": "2"
        },
        {
          "number": "K",
          "name": "cathode",
          "net": "VPROT",
          "kicad": "1"
        }
      ],
      "rationale": "Placed upstream of the shunt, so it protects the electronics without corrupting the measurement: the shunt still sees the true load current and the INA226 still measures the voltage the load actually receives. Costs roughly 0.3–0.4 V of headroom and 0.2 W at 0.5 A. Alternatives: ideal-diode controller (more parts), or omit and rely on a keyed connector.",
      "datasheet": "onsemi-ss34",
      "symbol": "diode"
    },
    {
      "ref": "D2",
      "value": "15 V standoff 600 W",
      "part": "Littelfuse SMBJ15A",
      "manufacturer": "Littelfuse",
      "function": "Transient clamp across the protected rail",
      "ratings": {
        "v_standoff": 15,
        "v_clamp": 24.4,
        "p_peak_w": 600
      },
      "pins": [
        {
          "number": "A",
          "name": "anode",
          "net": "GND",
          "kicad": "2"
        },
        {
          "number": "K",
          "name": "cathode",
          "net": "VPROT",
          "kicad": "1"
        }
      ],
      "rationale": "Standoff 15 V sits above the 12 V maximum input with margin; the clamp at 24.4 V stays below the INA226's 36 V absolute maximum. Alternatives: SMBJ12A (tighter but less margin above 12 V + tolerance), or a 5 V part if the envelope were fixed at 5 V.",
      "datasheet": "littelfuse-smbj",
      "symbol": "tvs"
    },
    {
      "ref": "R1",
      "value": "0.1 Ω 0.5 % 1 W",
      "part": "Vishay CRCW2512 0R1 1 W (or Panasonic ERJ-M1WS)",
      "manufacturer": "Vishay",
      "function": "Current shunt, external to the module",
      "ratings": {
        "resistance_ohm": 0.1,
        "tolerance_pct": 0.5,
        "power_w": 1,
        "tempco_ppm": 100
      },
      "pins": [
        {
          "number": "1",
          "name": "high",
          "net": "VPROT"
        },
        {
          "number": "2",
          "name": "low",
          "net": "VLOAD"
        }
      ],
      "rationale": "0.1 Ω puts 0.5 A at 50 mV — 61 % of the INA226's ±81.92 mV shunt range, so the full design current is measurable with headroom, while the burden voltage stays at 50 mV and dissipation at 25 mW. 0.5 % tolerance and 100 ppm/°C keep the gain error predictable. The same value caps the measurable current at 0.819 A: a later 1 A test needs 0.05 Ω and a fresh calibration, which is recorded in the design review.",
      "datasheet": "vishay-crcw2512",
      "symbol": "resistor"
    },
    {
      "ref": "U1",
      "value": "INA226AIDGSR",
      "part": "Texas Instruments INA226AIDGSR (VSSOP-10)",
      "manufacturer": "Texas Instruments",
      "function": "Bus voltage and shunt current measurement, I2C",
      "ratings": {
        "v_supply_min": 2.7,
        "v_supply_max": 5.5,
        "v_bus_max": 36,
        "v_shunt_fs_mv": 81.92,
        "i2c_address": "0x40",
        "pin_count": 10
      },
      "pins": [
        {
          "number": "1",
          "name": "A1",
          "net": "GND",
          "note": "address strap, tied low"
        },
        {
          "number": "2",
          "name": "A0",
          "net": "GND",
          "note": "address strap, tied low"
        },
        {
          "number": "3",
          "name": "ALERT",
          "net": "NC",
          "no_connect": true
        },
        {
          "number": "4",
          "name": "SDA",
          "net": "SDA"
        },
        {
          "number": "5",
          "name": "SCL",
          "net": "SCL"
        },
        {
          "number": "6",
          "name": "VS",
          "net": "3V3"
        },
        {
          "number": "7",
          "name": "GND",
          "net": "GND"
        },
        {
          "number": "8",
          "name": "VBUS",
          "net": "VLOAD"
        },
        {
          "number": "9",
          "name": "IN-",
          "net": "VLOAD"
        },
        {
          "number": "10",
          "name": "IN+",
          "net": "VPROT"
        }
      ],
      "rationale": "16-bit shunt and bus conversion, ±81.92 mV shunt range, 0–36 V bus, 2.7–5.5 V supply: works with 3.3 V logic and a 12 V bus without level shifting. IN+ goes to the supply side of the shunt and IN− to the load side; VBUS (pin 8) is wired to IN− so the reported bus voltage is the voltage the load actually receives. Alternatives: INA219 (12-bit, ±320 mV, 26 V), INA228 (20-bit, not hand-solderable).",
      "module_caveats": [
        "This revision specifies the bare INA226, not a breakout module: on the IC, VBUS is a separate pin (8) that must be tied to IN− for load-side measurement, and breakout boards differ in whether they do it.",
        "A module may be used as a build shortcut only if every pin below is accounted for on the module: VS, GND, SDA, SCL, IN+, IN−, VBUS, A0, A1.",
        "A0 and A1 must be strapped, never left floating. GND on both selects address 0x40.",
        "ALERT is an open-drain output, unused in V1 and explicitly marked no-connect."
      ],
      "datasheet": "ti-ina226",
      "symbol": "block"
    },
    {
      "ref": "C1",
      "value": "10 µF 25 V X7R",
      "part": "Murata GRM32ER71E106KA12 (1210)",
      "manufacturer": "Murata",
      "function": "Bulk decoupling at the module supply",
      "ratings": {
        "capacitance_f": 1e-05,
        "voltage_v": 25
      },
      "pins": [
        {
          "number": "1",
          "name": "+",
          "net": "3V3"
        },
        {
          "number": "2",
          "name": "-",
          "net": "GND"
        }
      ],
      "rationale": "Keeps the INA226 supply stable when the I2C bus is clocked and when the host board's regulator is shared. Alternatives: 4.7 µF, or a 22 µF electrolytic (polarity risk for a beginner).",
      "datasheet": "murata-grm",
      "symbol": "capacitor"
    },
    {
      "ref": "C2",
      "value": "100 nF 25 V X7R",
      "part": "Kemet C0603C104K3RAC (0603)",
      "manufacturer": "Kemet",
      "function": "High-frequency decoupling at the module supply",
      "ratings": {
        "capacitance_f": 1e-07,
        "voltage_v": 25
      },
      "pins": [
        {
          "number": "1",
          "name": "+",
          "net": "3V3"
        },
        {
          "number": "2",
          "name": "-",
          "net": "GND"
